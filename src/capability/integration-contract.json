                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "text"],
                  "additionalProperties": false
                }
              },
              "structured_content": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": ["content"],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "code": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "INTEGRATION_INVALID",
              "INTEGRATION_NOT_AUTHORIZED",
              "INTEGRATION_UNAVAILABLE",
              "INTEGRATION_LIMIT",
              "INTEGRATION_CHANGED",
              "INTEGRATION_CONFLICT",
              "INTEGRATION_UNRESOLVED",
              "INTEGRATION_NOT_FOUND",
              "INTEGRATION_TIMED_OUT",
              "INTEGRATION_CANCELLED",
              "LEASE_LOST",
              "CREDENTIAL_REVOKED",
              "CREDENTIAL_EXPIRED",
              "SCOPE_DENIED",
              "SCOPE_CHANGED",
              "REQUESTER_SCOPE_CHANGED",
              "CONVERSATION_CLEARED",
              "TASK_CAPABILITY_REQUIRED",
              "TASK_ROUTING_CHANGED",
              "AUTONOMY_NOT_AUTHORIZED",
              "AUTONOMY_NOT_FOUND",
              "AUTONOMY_DISABLED",
              "AUTONOMY_SCOPE_CHANGED",
              "AUTONOMY_MANDATE_CHANGED",
              "INTEGRATION_REMOTE_ERROR"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "protocol",
      "slot",
