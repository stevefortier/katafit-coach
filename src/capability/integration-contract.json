  "call_result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "protocol": {
        "type": "string",
        "const": "coach.integrations.v1"
      },
      "slot": {
        "type": "string",
