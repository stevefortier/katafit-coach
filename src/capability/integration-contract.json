      },
      "outcome": {
        "type": "string",
        "enum": ["unknown", "response_received", "response_error"]
      },
      "request_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "replay_allowed": {
        "type": "boolean",
        "const": false
      },
      "result": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
